# ---- room server (server.js) ----------------------------------------------
# All optional. Copy to .env and `set -a; source .env; set +a`, or set them in
# your host's environment (Railway: Variables tab).

PORT=3131
# Where rooms persist. The Dockerfile sets /data/rooms.json for a mounted volume.
ROUNDTABLE_DATA=data/rooms.json
# 1 = log every task/result/bridge event.
ROUNDTABLE_VERBOSE=0

# What a newly created table allows guests to do: open | managed | view
ROUNDTABLE_DEFAULT_ACCESS=managed
# 1 = only the host can put agents to work on a new table (guests still talk).
ROUNDTABLE_DEFAULT_HOST_ONLY_SPEND=1

# Room IDs authorized to use server-wide bridges or the house API key.
# Empty denies shared compute to every room; room-scoped bridges still work.
# Claim each room as host before authorizing it. No wildcard or branch inheritance.
# Example: launch-review,design-session
ROUNDTABLE_SHARED_ROOMS=

# Shared secret a bridge must present in bridge_join. Empty = any bridge may
# attach (fine on localhost, not on a public URL). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ROUNDTABLE_BRIDGE_SECRET=

# Number of trusted reverse proxies in front of the server (Railway = 1).
# Governs which X-Forwarded-For entry is treated as the client IP.
ROUNDTABLE_PROXY_HOPS=0
# Extra origins allowed to open a browser websocket, comma-separated.
ROUNDTABLE_ALLOWED_ORIGINS=
ROUNDTABLE_MAX_CONN_PER_IP=20
ROUNDTABLE_MAX_ROOMS=500

# House fallback brain. Leave UNSET on any public deployment: with a key here
# the server itself becomes spendable by anyone who finds the URL.
# ANTHROPIC_API_KEY=
# ROUNDTABLE_MODEL=claude-sonnet-4-6

# ---- bridge (bridge/codex.js) ---------------------------------------------
# Must match the server's ROUNDTABLE_BRIDGE_SECRET when one is set.
# ROUNDTABLE_BRIDGE_SECRET=
# Default Codex model for agents that don't pin one.
# ROUNDTABLE_CODEX_MODEL=
# Max agent turns this bridge will run per hour, whatever the server asks.
# ROUNDTABLE_BRIDGE_RUNS=60

# ---- personal workspaces (bridge/workspace.js) ------------------------------
# Private, room-scoped token generated by Connect my Codex. Only on your machine.
# ROUNDTABLE_PAIR_TOKEN=
# Shares ROUNDTABLE_BRIDGE_RUNS with the chat adapter (60/hour by default).
# Project, checks, preview folder, model and approach are bridge CLI options.

# Local one-click Codex manager (development / loopback browsers only).
# Set 0 to disable. Always disabled in production or when PROXY_HOPS is nonzero.
ROUNDTABLE_LOCAL_LAUNCHER=1
# Optional trusted CLI executable override, configured only on the server machine.
# ROUNDTABLE_CODEX_BIN=/path/to/codex
# Optional project folder when launching outside a Codex thread.
# Otherwise the launching CODEX_THREAD_ID supplies its project automatically.
# ROUNDTABLE_PROJECT=/path/to/project
